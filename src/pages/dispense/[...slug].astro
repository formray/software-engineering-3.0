---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const dispense = (await getCollection('dispense')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return dispense.map((dispensa, i) => ({
    params: { slug: dispensa.id },
    props: {
      dispensa,
      prev: dispense[i - 1] ?? null,
      next: dispense[i + 1] ?? null,
      total: dispense.length,
    },
  }));
}

const { dispensa, prev, next, total } = Astro.props;
const { Content, headings } = await render(dispensa);
const base = import.meta.env.BASE_URL;

const words = dispensa.body ? dispensa.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.ceil(words / 200));
const nn = String(dispensa.data.order).padStart(2, '0');
---

<ArticleLayout
  title={dispensa.data.title}
  description={dispensa.data.description}
  category="dispensa"
  eyebrow={`Dispensa ${nn} di ${String(total - 1).padStart(2, '0')} · ${dispensa.data.argomento}`}
  readingTime={readingTime}
  date={dispensa.data.date}
  headings={headings}
>
  <Content />

  <nav class="dispensa-nav" data-pagefind-ignore aria-label="Navigazione della serie">
    {prev ? (
      <a href={`${base}/dispense/${prev.id}`} class="nav-prev">
        <span class="nav-label">Precedente</span>
        <span class="nav-title">{String(prev.data.order).padStart(2, '0')} · {prev.data.title}</span>
      </a>
    ) : (
      <span class="nav-spacer"></span>
    )}
    {next ? (
      <a href={`${base}/dispense/${next.id}`} class="nav-next">
        <span class="nav-label">Successiva</span>
        <span class="nav-title">{String(next.data.order).padStart(2, '0')} · {next.data.title}</span>
      </a>
    ) : (
      <span class="nav-spacer"></span>
    )}
  </nav>
</ArticleLayout>

<style>
  .dispensa-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-top: 3.5rem;
  }

  .dispensa-nav a, .nav-spacer {
    background: var(--paper);
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-decoration: none;
    transition: background 0.18s ease;
  }

  .dispensa-nav a:hover { background: #ffffff; text-decoration: none; }

  .nav-next { text-align: right; }

  .nav-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .nav-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink);
    transition: color 0.18s ease;
  }

  .dispensa-nav a:hover .nav-title { color: var(--accent-deep); }

  @media (max-width: 640px) {
    .dispensa-nav { grid-template-columns: 1fr; }
    .nav-next { text-align: left; }
  }
</style>
