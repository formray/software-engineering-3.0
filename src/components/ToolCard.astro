---
interface Props {
  title: string;
  subtitle?: string;
  pricing?: string;
}

const { title, subtitle, pricing } = Astro.props;
---

<div class="tool-card-component">
  <h4>{title}</h4>
  {subtitle && <p class="subtitle">{subtitle}</p>}
  {pricing && <div class="pricing">{pricing}</div>}
  <div class="content">
    <slot />
  </div>
</div>

<style>
  .tool-card-component {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 1.35rem 1.5rem;
    margin: 1.25rem 0;
    transition: border-color 0.18s ease;
  }

  .tool-card-component:hover { border-color: var(--ink-3); }

  h4 {
    color: var(--ink);
    font-family: var(--serif);
    margin: 0 0 0.35rem 0;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .subtitle {
    color: var(--ink-2);
    font-weight: 500;
    margin: 0 0 0.6rem 0;
    font-size: 0.9rem;
  }

  .pricing {
    display: inline-block;
    border: 1px solid var(--line);
    color: var(--ink-2);
    padding: 0.2rem 0.6rem;
    border-radius: 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    margin-bottom: 0.75rem;
  }

  .content { color: var(--ink); }
  .content :global(p) { margin: 0.5rem 0; color: var(--ink); }
  .content :global(ul) { margin: 0.5rem 0; padding-left: 1.25rem; }
  .content :global(li) { color: var(--ink); margin-bottom: 0.35rem; }
</style>
