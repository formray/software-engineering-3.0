---
interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<div class="pros-cons-grid">
  <div class="pc pros">
    <span class="pc-label">Pro</span>
    <ul>
      {pros.map((pro) => <li>{pro}</li>)}
    </ul>
  </div>
  <div class="pc cons">
    <span class="pc-label">Contro</span>
    <ul>
      {cons.map((con) => <li>{con}</li>)}
    </ul>
  </div>
</div>

<style>
  .pros-cons-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .pc { padding: 1.15rem 1.3rem; border-radius: 0; }

  .pros { background: var(--ok-bg); border-left: 2px solid var(--ok); }
  .cons { background: var(--danger-bg); border-left: 2px solid var(--danger); }

  .pc-label {
    display: block;
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .pros .pc-label { color: var(--ok); }
  .cons .pc-label { color: var(--danger); }

  ul { margin: 0; padding-left: 1.2rem; list-style-type: disc; }

  li { color: var(--ink); margin-bottom: 0.45rem; font-size: 0.95rem; }
  li:last-child { margin-bottom: 0; }

  @media (max-width: 768px) {
    .pros-cons-grid { grid-template-columns: 1fr; }
  }
</style>
