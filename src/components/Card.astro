---
import CardCover from './CardCover.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  href?: string;
  date?: Date;
  order?: number;
  readingMin?: number;
  pill?: string;
  ghost?: boolean;
  delay?: number;
  idx?: number;
  coverSection: 'dispense' | 'fondamenta' | 'guide' | 'analisi';
  coverSeed: string;
}

const {
  title, description, eyebrow, href, date, order, readingMin, pill,
  ghost = false, delay = 0, idx = 0, coverSection, coverSeed,
} = Astro.props;

const displayDate = date
  ? date
      .toLocaleDateString('it-IT', { month: 'long', year: 'numeric' })
      .replace(/^./, (c) => c.toUpperCase())
  : null;
const metaLeft = [displayDate, readingMin ? `${readingMin} min` : null].filter(Boolean).join(' · ');
const Tag = ghost ? 'div' : 'a';
const nn = order !== undefined ? String(order).padStart(2, '0') : undefined;
---

<Tag
  {...(ghost ? {} : { href })}
  class:list={['mcard', 'rv', { ghost }]}
  style={delay ? `transition-delay: ${delay}ms` : undefined}
  data-date={date ? date.toISOString().slice(0, 10) : ''}
  data-title={title.toLowerCase()}
  data-idx={idx}
>
  <CardCover
    seed={coverSeed}
    section={coverSection}
    motif={coverSection === 'dispense' ? order : undefined}
    number={nn}
    ghost={ghost}
  />
  <div class="m-body">
    <span class="m-eyebrow">
      <span>{eyebrow}</span>
      {pill && <span class:list={['pill', pill === 'In coda' ? 'pill-coda' : 'pill-nuovo']}>{pill}</span>}
    </span>
    <span class="m-title">{title}</span>
    <span class="m-desc">{description}</span>
    <span class="m-meta">
      <span>{metaLeft}</span>
      {!ghost && <span class="m-arrow" aria-hidden="true">→</span>}
    </span>
  </div>
</Tag>

<style>
  .mcard {
    background: var(--paper);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: background 0.18s ease, border-color 0.18s ease, opacity 0.55s ease, transform 0.55s ease;
  }

  a.mcard:hover { background: #ffffff; border-color: var(--ink-3); text-decoration: none; }

  .mcard.ghost { opacity: 1; border-style: dashed; background: transparent; }
  .mcard.ghost .m-title { color: var(--ink-3); }
  .mcard.ghost .m-desc { color: var(--ink-3); }

  .m-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.15rem 1.3rem 1.3rem;
    flex-grow: 1;
  }

  .m-eyebrow {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .m-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
    transition: color 0.18s ease;
  }

  a.mcard:hover .m-title { color: var(--accent-deep); }

  .m-desc {
    font-size: 0.85rem;
    color: var(--ink-2);
    line-height: 1.5;
    flex-grow: 1;
  }

  .m-meta {
    font-size: 0.75rem;
    color: var(--ink-3);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    min-height: 1.1em;
  }

  .m-arrow { transition: transform 0.18s ease; }
  a.mcard:hover .m-arrow { transform: translateX(4px); color: var(--accent-deep); }
</style>
