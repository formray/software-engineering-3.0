---
interface Props {
  version: string;
}

const { version } = Astro.props;
---

<span class="version-badge-component">{version}</span>

<style>
  .version-badge-component {
    display: inline-block;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink-2);
    padding: 0.28em 0.8em;
    border-radius: 0;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 500;
    margin: 0.5rem 0;
  }
</style>
