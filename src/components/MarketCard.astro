---
interface Props {
  name: string;
  tier?: 'leader' | 'challenger' | 'other';
  stats?: string[];
  badge?: string;
}

const { name, tier = 'other', stats = [], badge } = Astro.props;

const tierColors = {
  leader: { bg: 'var(--ok-bg)', border: 'var(--ok)', text: 'var(--ok)' },
  challenger: { bg: 'var(--warn-bg)', border: 'var(--warn)', text: 'var(--warn)' },
  other: { bg: 'var(--panel)', border: 'var(--line)', text: 'var(--ink)' },
};

const colors = tierColors[tier];
---

<div class="market-card" style={`background: ${colors.bg}; border-left-color: ${colors.border};`}>
  <div class="header">
    <h4 style={`color: ${colors.text};`}>{name}</h4>
    {badge && <span class="mc-badge">{badge}</span>}
  </div>
  {stats.length > 0 && (
    <ul class="stats-list">
      {stats.map((stat) => <li>{stat}</li>)}
    </ul>
  )}
  <div class="content">
    <slot />
  </div>
</div>

<style>
  .market-card {
    border: none;
    border-left: 2px solid;
    border-radius: 0;
    padding: 1.15rem 1.4rem;
    margin: 1rem 0;
  }

  .header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  h4 {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .mc-badge {
    font-family: var(--sans);
    border: 1px solid currentColor;
    color: var(--ink-2);
    padding: 0.15rem 0.5rem;
    border-radius: 0;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .stats-list {
    list-style: none;
    padding: 0;
    margin: 0 0 0.6rem 0;
  }

  .stats-list li {
    color: var(--ink-2);
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }

  .content { color: var(--ink); font-size: 0.95rem; }
  .content :global(p) { margin: 0.4rem 0; }
</style>
