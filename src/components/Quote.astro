---
interface Props {
  author?: string;
  source?: string;
}

const { author, source } = Astro.props;
---

<blockquote class="quote-component">
  <div class="quote-content">
    <slot />
  </div>
  {(author || source) && (
    <footer class="quote-footer">
      {author && <cite class="author">— {author}</cite>}
      {source && <span class="source">{source}</span>}
    </footer>
  )}
</blockquote>

<style>
  .quote-component {
    background: var(--panel);
    border-left: 2px solid var(--accent);
    border-radius: 0;
    padding: 1.5rem 1.75rem;
    margin: 2rem 0;
  }

  .quote-content {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.55;
  }

  .quote-content :global(p) { margin: 0; }

  .quote-footer {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: var(--sans);
  }

  .author {
    color: var(--accent-deep);
    font-style: normal;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .source {
    color: var(--ink-3);
    font-size: 0.8rem;
  }
</style>
