---
const base = import.meta.env.BASE_URL;
---

<div class="search-container" data-pagefind-ignore>
  <div id="search"></div>
</div>

<link href={`${base}/pagefind/pagefind-ui.css`} rel="stylesheet" />
<script is:inline define:vars={{ base }}>
  (function () {
    function initSearch() {
      const el = document.getElementById('search');
      if (!el || el.dataset.ready) return;
      el.dataset.ready = '1';
      const boot = () => {
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Cerca tra dispense, articoli e guide…',
            zero_results: 'Nessun risultato per "[SEARCH_TERM]"',
            many_results: '[COUNT] risultati per "[SEARCH_TERM]"',
            one_result: '1 risultato per "[SEARCH_TERM]"',
            clear_search: 'Cancella',
            load_more: 'Carica altri risultati',
          },
          baseUrl: base,
        });
      };
      if (window.PagefindUI) { boot(); return; }
      const script = document.createElement('script');
      script.src = `${base}/pagefind/pagefind-ui.js`;
      script.onload = boot;
      document.head.appendChild(script);
    }
    document.addEventListener('astro:page-load', initSearch);
    if (document.readyState !== 'loading') initSearch();
    else window.addEventListener('DOMContentLoaded', initSearch);
  })();
</script>

<style>
  .search-container {
    flex: 1 1 260px;
    max-width: 620px;
    margin: 0;
  }

  :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: #B85C3D;
    --pagefind-ui-text: #141413;
    --pagefind-ui-background: #FAF9F5;
    --pagefind-ui-border: #E8E6DC;
    --pagefind-ui-tag: #F0EEE6;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0px;
    --pagefind-ui-font: 'Archivo', system-ui, sans-serif;
  }

  :global(.pagefind-ui__search-input) {
    background: var(--pagefind-ui-background) !important;
    color: var(--pagefind-ui-text) !important;
    border: 1px solid var(--pagefind-ui-border) !important;
    border-radius: 0 !important;
    font-weight: 400 !important;
    font-size: 0.95rem !important;
  }

  :global(.pagefind-ui__search-input::placeholder) {
    color: #75746E !important;
    opacity: 1 !important;
  }

  :global(.pagefind-ui__search-input:focus) {
    border-color: #141413 !important;
    outline: none !important;
    box-shadow: none !important;
  }

  :global(.pagefind-ui__search-clear) {
    color: #75746E !important;
    background: transparent !important;
  }

  :global(.pagefind-ui__drawer) {
    background: #FFFFFF;
    border: 1px solid var(--pagefind-ui-border);
    border-top: none;
    padding: 0 1rem;
  }

  :global(.pagefind-ui__result) {
    border-bottom: 1px solid var(--pagefind-ui-border) !important;
    padding: 0.9rem 0 !important;
  }

  :global(.pagefind-ui__result-link) {
    color: var(--pagefind-ui-text) !important;
    font-family: 'Source Serif 4', Georgia, serif !important;
    font-weight: 600 !important;
    text-decoration: none !important;
  }

  :global(.pagefind-ui__result-link:hover) {
    color: var(--pagefind-ui-primary) !important;
  }

  :global(.pagefind-ui__result-excerpt) {
    color: #5E5D59 !important;
    font-size: 0.85rem !important;
  }

  :global(.pagefind-ui__result-excerpt mark) {
    background: #F0EEE6 !important;
    color: #B85C3D !important;
  }

  :global(.pagefind-ui__message) {
    color: #75746E !important;
  }

  :global(.pagefind-ui__button) {
    background: transparent !important;
    color: #141413 !important;
    border: 1px solid #141413 !important;
    border-radius: 0 !important;
    cursor: pointer !important;
  }

  :global(.pagefind-ui__button:hover) {
    color: #B85C3D !important;
    border-color: #B85C3D !important;
  }
</style>
