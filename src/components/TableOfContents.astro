---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

// Solo h2 e h3
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{toc.length > 0 && (
  <nav class="toc-side" aria-label="Indice">
    <span class="toc-label">Indice</span>
    <ul>
      {toc.map((heading) => (
        <li class={`toc-depth-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc-side {
    border-top: 1px solid var(--ink);
    padding-top: 0.9rem;
    font-family: var(--sans);
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
  }

  .toc-label {
    display: block;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.7rem;
  }

  ul { list-style: none; margin: 0; padding: 0; }

  li { margin: 0; }

  a {
    display: block;
    padding: 0.28rem 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s ease;
  }

  li:last-child a { border-bottom: none; }

  .toc-depth-3 a { padding-left: 0.9rem; color: var(--ink-3); }

  a:hover { color: var(--accent-deep); text-decoration: none; }
</style>
