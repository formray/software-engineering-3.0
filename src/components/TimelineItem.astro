---
interface Props {
  period: string;
  title: string;
}

const { period, title } = Astro.props;
---

<div class="timeline-item">
  <div class="timeline-marker"></div>
  <div class="timeline-content">
    <span class="period">{period}</span>
    <h4>{title}</h4>
    <div class="description">
      <slot />
    </div>
  </div>
</div>

<style>
  .timeline-item {
    position: relative;
    padding-left: 2.2rem;
    padding-bottom: 1.8rem;
    border-left: 1px solid var(--line);
  }

  .timeline-item:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }

  .timeline-marker {
    position: absolute;
    left: -6px;
    top: 0.3rem;
    width: 11px;
    height: 11px;
    background: var(--paper);
    border: 1.5px solid var(--accent-deep);
  }

  .period {
    display: inline-block;
    font-family: var(--mono);
    color: var(--accent-deep);
    font-size: 0.75rem;
    font-weight: 500;
    margin-bottom: 0.35rem;
  }

  h4 {
    color: var(--ink);
    font-family: var(--serif);
    margin: 0 0 0.4rem 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .description { color: var(--ink-2); font-size: 0.95rem; }
  .description :global(p) { margin: 0.25rem 0; }
  .description :global(ul) { margin: 0.5rem 0; padding-left: 1.25rem; }
  .description :global(pre) { margin: 0.75rem 0; }
</style>
