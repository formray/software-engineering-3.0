---
interface Props {
  stats: Array<{
    value: string;
    label: string;
    color?: 'blue' | 'green' | 'red' | 'orange' | 'purple';
  }>;
}

const { stats } = Astro.props;

const colorMap = {
  blue: 'var(--accent-deep)',
  green: 'var(--ok)',
  red: 'var(--danger)',
  orange: 'var(--warn)',
  purple: 'var(--ink-2)',
};
---

<div class="stat-grid">
  {stats.map((stat) => (
    <div class="stat-item">
      <div class="stat-value" style={`color: ${colorMap[stat.color || 'blue']};`}>
        {stat.value}
      </div>
      <div class="stat-label">{stat.label}</div>
    </div>
  ))}
</div>

<style>
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .stat-item {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 0;
    padding: 1.4rem 1.2rem;
    text-align: left;
  }

  .stat-value {
    font-family: var(--serif);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    color: var(--ink-2);
    font-size: 0.85rem;
    margin-top: 0.45rem;
  }
</style>
