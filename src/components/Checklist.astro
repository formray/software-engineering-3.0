---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="checklist-component">
  {items.map((item) => <li>{item}</li>)}
</ul>

<style>
  .checklist-component {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  li {
    position: relative;
    padding-left: 1.9rem;
    margin-bottom: 0.7rem;
    color: var(--ink);
  }

  li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 0.72em;
    height: 0.72em;
    border: 1.5px solid var(--accent-deep);
  }
</style>
