---
interface Props {
  type?: 'info' | 'success' | 'warning' | 'danger' | 'highlight';
  title?: string;
}

const { type = 'info', title } = Astro.props;
---

<div class:list={['info-box-component', `ib-${type}`]}>
  {title && <span class="ib-label">{title}</span>}
  <div class="content">
    <slot />
  </div>
</div>

<style>
  .info-box-component {
    border-left: 2px solid var(--ink);
    border-radius: 0;
    padding: 1.1rem 1.35rem;
    margin: 1.5rem 0;
    background: var(--panel);
  }

  .ib-info { background: var(--panel); border-left-color: var(--ink); }
  .ib-highlight { background: var(--panel); border-left-color: var(--accent); }
  .ib-success { background: var(--ok-bg); border-left-color: var(--ok); }
  .ib-warning { background: var(--warn-bg); border-left-color: var(--warn); }
  .ib-danger { background: var(--danger-bg); border-left-color: var(--danger); }

  .ib-label {
    display: block;
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    margin-bottom: 0.45rem;
  }

  .ib-info .ib-label { color: var(--ink-2); }
  .ib-highlight .ib-label { color: var(--accent-deep); }
  .ib-success .ib-label { color: var(--ok); }
  .ib-warning .ib-label { color: var(--warn); }
  .ib-danger .ib-label { color: var(--danger); }

  .content { color: var(--ink); }

  .content :global(p) { margin: 0; color: var(--ink); }
  .content :global(p:not(:last-child)) { margin-bottom: 0.75rem; }
  .content :global(ul), .content :global(ol) { margin: 0.5rem 0 0 0; padding-left: 1.25rem; }
  .content :global(li) { color: var(--ink); margin-bottom: 0.4rem; }
  .content :global(pre) { margin: 0.75rem 0 0; }
</style>
