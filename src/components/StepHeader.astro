---
interface Props {
  number: number;
  title: string;
}

const { number, title } = Astro.props;
---

<div class="step-header-component">
  <span class="step-number">{number}</span>
  <h3>{title}</h3>
</div>

<style>
  .step-header-component {
    display: flex;
    align-items: center;
    margin: 2.5rem 0 1.25rem;
    gap: 0.85rem;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 0;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.25rem;
  }
</style>
