---
interface Props {
  leftTitle: string;
  rightTitle: string;
  leftItems: string[];
  rightItems: string[];
  leftColor?: 'red' | 'green' | 'blue' | 'orange' | 'purple';
  rightColor?: 'red' | 'green' | 'blue' | 'orange' | 'purple';
}

const { leftTitle, rightTitle, leftItems, rightItems, leftColor = 'red', rightColor = 'green' } = Astro.props;

const colorMap = {
  red: { bg: 'var(--danger-bg)', border: 'var(--danger)', text: 'var(--danger)' },
  green: { bg: 'var(--ok-bg)', border: 'var(--ok)', text: 'var(--ok)' },
  blue: { bg: 'var(--panel)', border: 'var(--accent)', text: 'var(--accent-deep)' },
  orange: { bg: 'var(--warn-bg)', border: 'var(--warn)', text: 'var(--warn)' },
  purple: { bg: 'var(--panel)', border: 'var(--ink-2)', text: 'var(--ink-2)' },
};

const left = colorMap[leftColor];
const right = colorMap[rightColor];
---

<div class="comparison-grid">
  <div class="comparison-side" style={`background: ${left.bg}; border-left-color: ${left.border};`}>
    <span class="cmp-label" style={`color: ${left.text};`}>{leftTitle}</span>
    <ul>
      {leftItems.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <div class="comparison-side" style={`background: ${right.bg}; border-left-color: ${right.border};`}>
    <span class="cmp-label" style={`color: ${right.text};`}>{rightTitle}</span>
    <ul>
      {rightItems.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>

<style>
  .comparison-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .comparison-side {
    padding: 1.15rem 1.3rem;
    border-radius: 0;
    border-left: 2px solid;
  }

  .cmp-label {
    display: block;
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  ul { margin: 0; padding-left: 1.2rem; list-style-type: disc; }

  li { color: var(--ink); margin-bottom: 0.45rem; font-size: 0.95rem; }
  li:last-child { margin-bottom: 0; }

  @media (max-width: 768px) {
    .comparison-grid { grid-template-columns: 1fr; }
  }
</style>
